---
import { site, contact, getHome, addressLines } from '../lib/content';
import { withBase } from '../lib/url';
import { homeAnchor, routes, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const { meta } = getHome(locale);
const year = new Date().getFullYear();
---
<footer class="overflow-hidden bg-ink text-sand">
  <div class="container-x grid gap-12 pt-20 pb-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="display text-title max-w-md">{t('footer.tagline')} <span class="accent text-terra">{t('footer.taglineAccent')}</span></p>
      <a href={homeAnchor(locale, 'contact')} class="btn btn-terra mt-8">{t('footer.cta')}</a>
    </div>

    <div class="grid gap-10 sm:grid-cols-3 md:col-span-7">
      <div>
        <h2 class="eyebrow text-sand/50">{t('footer.contact')}</h2>
        <ul class="mt-4 space-y-2">
          <li><a class="link-underline" href={contact.tel}>{site.phone}</a></li>
          <li><a class="link-underline break-all" href={contact.mailto}>{site.email}</a></li>
          {contact.whatsapp && <li><a class="link-underline" href={contact.whatsapp} rel="noopener" target="_blank">WhatsApp</a></li>}
          <li class="text-sand/60">{meta.availability}</li>
        </ul>
      </div>
      <div>
        <h2 class="eyebrow text-sand/50">{t('footer.studio')}</h2>
        <address class="mt-4 not-italic leading-relaxed text-sand/80">
          {site.company}<br />
          {addressLines(locale).map((line) => (<>{line}<br /></>))}
        </address>
      </div>
      <div>
        <h2 class="eyebrow text-sand/50">{t('footer.legal')}</h2>
        <ul class="mt-4 space-y-2">
          <li><a class="link-underline" href={withBase(routes.terms(locale))}>{t('footer.terms')}</a></li>
          <li><a class="link-underline" href={withBase(routes.privacy(locale))}>{t('footer.privacy')}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container-x" aria-hidden="true">
    <p class="display select-none text-[clamp(5rem,25vw,24rem)] leading-[0.78] tracking-[-0.055em] text-sand/[0.07]">lucsoft</p>
  </div>

  <div class="container-x flex flex-col gap-2 border-t border-sand/10 py-6 text-sm text-sand/50 sm:flex-row sm:justify-between">
    <p>© {year} {site.company}. {t('footer.rights')}</p>
    <p>{t('footer.madeIn')}</p>
  </div>
</footer>
