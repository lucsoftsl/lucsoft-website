---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowserFrame from '../BrowserFrame.astro';
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import PhoneFrame from '../PhoneFrame.astro';
import { withBase } from '../../lib/url';
import { storeLinks, workSlug } from '../../lib/work';
import { caseStudy, mobileApp } from '../../lib/schema';
import { alternatesFor, homeAnchor, routes, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  project: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { locale, project, next } = Astro.props;
const t = useTranslations(locale);
const { data } = project;
const { Content } = await render(project);
const slug = workSlug(project);
const alternates = alternatesFor((l) => routes.work(l, slug));
const stores = storeLinks(data);
const app = mobileApp(alternates[locale], project);
---
<BaseLayout
  locale={locale}
  alternates={alternates}
  title={`${data.client} — ${t('work.pageTitle')}`}
  description={data.summary}
  image={data.screenshot ?? data.cover}
  imageAlt={`${data.client} — ${t('work.homepage')}`}
  breadcrumb={data.client}
  schema={[caseStudy(locale, alternates[locale], project), ...(app ? [app] : [])]}
>
  <article>
    <header class="container-x pt-36 pb-12 md:pt-44">
      <a href={homeAnchor(locale, 'work')} class="eyebrow inline-flex items-center gap-2 text-ink-2 hover:text-ink">
        <Icon name="arrow-right" size={14} class="rotate-180" /> {t('work.allWork')}
      </a>
      <p class="eyebrow mt-10 flex items-center gap-2 text-ink-2" data-reveal>
        <span class="size-2 rounded-full" style={`background:${data.accent}`}></span>{data.category}
      </p>
      <h1 class="display mt-5 text-hero" data-reveal style="--i:1">{data.client}</h1>
      <p class="accent mt-4 max-w-3xl text-3xl leading-tight text-ink-2 md:text-4xl" data-reveal style="--i:2">{data.title}</p>
    </header>

    <div class="container-x" data-reveal style="--i:2">
      <BrowserFrame src={data.screenshot ?? data.cover} alt={`${data.client} — ${t('work.homepage')}`} url={data.url} sizes="(min-width: 1408px) 1312px, 100vw" eager />
    </div>

    <div class="container-x grid gap-12 py-20 md:py-28 lg:grid-cols-12">
      <dl class="grid grid-cols-2 gap-6 self-start lg:col-span-4 lg:grid-cols-1">
        <div><dt class="eyebrow text-ink-2">{t('work.client')}</dt><dd class="mt-1 text-lg font-medium">{data.client}</dd></div>
        {data.location && <div><dt class="eyebrow text-ink-2">{t('work.location')}</dt><dd class="mt-1 text-lg font-medium">{data.location}</dd></div>}
        {data.year && <div><dt class="eyebrow text-ink-2">{t('work.year')}</dt><dd class="mt-1 text-lg font-medium">{data.year}</dd></div>}
        <div>
          <dt class="eyebrow text-ink-2">{t('work.liveSite')}</dt>
          <dd class="mt-1 text-lg font-medium"><a href={data.url} target="_blank" rel="noopener" class="link-underline inline-flex items-center gap-1">{new URL(data.url).hostname.replace(/^www\./, '')} <Icon name="arrow-up-right" size={16} /></a></dd>
        </div>
        {stores.length > 0 && (
          <div>
            <dt class="eyebrow text-ink-2">{t('work.app')}</dt>
            <dd class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-lg font-medium">
              {stores.map((store) => (
                <a href={store.href} target="_blank" rel="noopener" class="link-underline inline-flex items-center gap-1">{store.label} <Icon name="arrow-up-right" size={16} /></a>
              ))}
            </dd>
          </div>
        )}
      </dl>
      <div class="lg:col-span-8">
        <div class="space-y-6 text-xl leading-relaxed text-ink-2 md:text-2xl [&>p:first-child]:text-ink">
          <Content />
        </div>
        {data.services.length > 0 && (
          <>
            <h2 class="eyebrow mt-14 text-ink-2">{t('work.inside')}</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {data.services.map((s) => <li class="rounded-full bg-paper px-4 py-2 ring-1 ring-line">{s}</li>)}
            </ul>
          </>
        )}
      </div>
    </div>

    {data.appScreens.length > 0 && (
      <section aria-labelledby="app-title" class="mb-20 overflow-hidden bg-sand-2 py-20 md:mb-28 md:py-28">
        <div class="container-x">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 id="app-title" class="display text-title" data-reveal>{t('work.appTitle')} <span class="accent text-terra-deep">{t('work.appTitleAccent')}</span></h2>
            {stores.length > 0 && (
              <div class="flex flex-wrap gap-3" data-reveal style="--i:1">
                {stores.map((store, i) => (
                  <a href={store.href} target="_blank" rel="noopener" class:list={['btn', i === 0 ? 'btn-ink' : 'btn-ghost']}>
                    {store.label} <Icon name="arrow-up-right" size={16} />
                  </a>
                ))}
              </div>
            )}
          </div>
          <div role="region" aria-labelledby="app-title" tabindex="0" class="-mx-2 mt-12 overflow-x-auto px-2 pb-6 [scrollbar-width:thin]" data-reveal style="--i:2">
            <ul class="flex snap-x snap-mandatory gap-5">
              {data.appScreens.map((screen) => (
                <li class="w-56 shrink-0 snap-start md:w-64">
                  <PhoneFrame src={screen.src} alt={screen.alt} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    {data.gallery.length > 0 && (
      <section aria-label={t('work.gallery')} class="container-x">
        <ul class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>li]:mb-4">
          {data.gallery.map((image, i) => (
            <li class="break-inside-avoid overflow-hidden rounded-(--radius-card)" data-reveal style={`--i:${i % 3}`}>
              <Img src={image.src} alt={image.alt} sizes="(min-width: 1408px) 430px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="w-full transition-transform duration-[1.2s] ease-(--ease-out-expo) hover:scale-[1.03]" />
            </li>
          ))}
        </ul>
      </section>
    )}

    {next.id !== project.id && (
      <a href={withBase(routes.work(locale, workSlug(next)))} class="group mt-20 block border-t border-line">
        <div class="container-x flex items-end justify-between gap-6 py-16 md:py-24">
          <div>
            <p class="eyebrow text-ink-2">{t('work.next')}</p>
            <p class="display mt-3 text-display transition-colors group-hover:text-terra-deep">{next.data.client}</p>
          </div>
          <span class="grid size-16 shrink-0 place-items-center rounded-full bg-ink text-sand transition-transform duration-500 ease-(--ease-out-expo) group-hover:rotate-[-45deg] md:size-24">
            <Icon name="arrow-right" size={28} />
          </span>
        </div>
      </a>
    )}
  </article>

  <section class="bg-terra">
    <div class="container-x flex flex-col items-start justify-between gap-8 py-16 md:flex-row md:items-center">
      <p class="display text-title">{t('work.cta')} <span class="accent">{t('work.ctaAccent')}</span></p>
      <a href={homeAnchor(locale, 'contact')} class="btn btn-ink">{t('work.ctaButton')} <Icon name="arrow-right" size={18} class="arrow" /></a>
    </div>
  </section>
</BaseLayout>
