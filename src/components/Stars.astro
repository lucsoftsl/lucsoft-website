---
interface Props { rating: number; label: string; class?: string }
const { rating, label, class: className } = Astro.props;
---
<div class:list={['flex gap-0.5 text-sun', className]} role="img" aria-label={`${rating} ${label}`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class={i < rating ? 'fill-current' : 'fill-current opacity-25'}>
      <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.5 1.3 6.6L12 17.3l-5.9 3.2 1.3-6.6-4.9-4.5 6.6-.8z" />
    </svg>
  ))}
</div>
