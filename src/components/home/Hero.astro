---
import type { CollectionEntry } from 'astro:content';
import BrowserFrame from '../BrowserFrame.astro';
import Icon from '../Icon.astro';
import { getHome } from '../../lib/content';
import { withBase } from '../../lib/url';
import { workSlug } from '../../lib/work';
import { homeAnchor, routes, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props { locale: Locale; projects: CollectionEntry<'work'>[] }
const { locale, projects } = Astro.props;
const t = useTranslations(locale);
const { hero, meta } = getHome(locale);
const [front, back] = projects;
---
<section aria-labelledby="hero-title" class="grain relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <!-- Soft sun glow behind the headline for warmth and depth. -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 right-[-10%] -z-10 size-[42rem] rounded-full bg-[radial-gradient(circle,rgb(242_179_61/0.35),transparent_65%)] blur-2xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-[-15%] -z-10 size-[36rem] rounded-full bg-[radial-gradient(circle,rgb(228_87_46/0.18),transparent_65%)] blur-2xl"></div>

  <div class="container-x">
    <p class="eyebrow mb-8 flex items-center gap-3 text-ink-2" data-reveal>
      <span class="inline-block h-px w-10 bg-ink/40"></span>{hero.eyebrow}
    </p>

    <h1 id="hero-title" class="display text-hero">
      <span class="block" data-reveal style="--i:1">{hero.titleBefore}</span>
      <span class="accent block pl-[0.08em] text-terra-deep" data-reveal style="--i:2">{hero.titleAccent}</span>
    </h1>

    <div class="mt-12 grid items-end gap-12 lg:mt-4 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:pb-10">
        <p class="max-w-md text-lg leading-relaxed text-ink-2 md:text-xl" data-reveal style="--i:3">{hero.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--i:4">
          <a href={homeAnchor(locale, 'contact')} class="btn btn-ink">{hero.primaryCta} <Icon name="arrow-right" size={18} class="arrow" /></a>
          <a href={homeAnchor(locale, 'work')} class="btn btn-ghost">{hero.secondaryCta}</a>
        </div>
        <p class="mt-8 flex items-center gap-2 text-sm text-ink-2" data-reveal style="--i:5">
          <Icon name="clock" size={16} /> {meta.availability} · {t('hero.channels')}
        </p>
      </div>

      {front && (
        <div class="relative lg:col-span-7" aria-label={t('hero.recent')}>
          {back?.data.screenshot && (
            <div class="absolute -top-10 right-0 hidden w-[72%] rotate-[4deg] opacity-95 md:block" data-reveal style="--i:4">
              <BrowserFrame src={back.data.screenshot} alt={`${back.data.client} — ${t('work.website')}`} url={back.data.url} />
            </div>
          )}
          <a
            href={withBase(routes.work(locale, workSlug(front)))}
            class="group relative block w-full -rotate-[2deg] transition-transform duration-700 ease-(--ease-out-expo) hover:rotate-0 md:mt-24 md:w-[82%]"
            data-reveal
            style="--i:3"
          >
            <BrowserFrame src={front.data.screenshot ?? front.data.cover} alt={`${front.data.client} — ${t('work.website')}`} url={front.data.url} eager />
            <span class="absolute -bottom-5 left-6 inline-flex items-center gap-2 rounded-full bg-ink px-4 py-2 text-sm font-medium text-sand shadow-lg">
              <span class="accent text-base text-terra">{t('hero.latest')}</span> {front.data.client}
              <Icon name="arrow-up-right" size={16} class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </span>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
