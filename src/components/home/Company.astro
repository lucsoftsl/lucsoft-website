---
import { getHome } from '../../lib/content';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { company } = getHome(Astro.props.locale);
---
<section aria-labelledby="company-title" class="container-x py-24 md:py-36">
  <div class="grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 id="company-title" class="display text-display" data-reveal>
        {company.title}<br /><span class="accent text-terra-deep">{company.titleAccent}</span>
      </h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2 md:text-xl" data-reveal style="--i:1">{company.lead}</p>
    </div>
    <ol class="space-y-4 lg:col-span-5 lg:pt-6">
      {company.points.map((point, i) => (
        <li
          class="group rounded-(--radius-card) lg:ml-(--stagger) bg-paper p-7 shadow-[0_1px_0_rgb(19_19_19/0.06)] transition-[transform,box-shadow] duration-500 ease-(--ease-out-expo) hover:-translate-y-1 hover:shadow-[0_24px_50px_-24px_rgb(19_19_19/0.35)]"
          style={`--i:${i + 1}; --stagger:${i * 1.5}rem`}
          data-reveal
        >
          <span class="accent text-lg text-terra-deep">0{i + 1}</span>
          <h3 class="mt-1 text-xl font-semibold tracking-[-0.02em]">{point.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-2">{point.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
