---
import SectionHeading from '../SectionHeading.astro';
import { getHome } from '../../lib/content';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const { services } = getHome(locale);
// Bento rhythm: first and last tiles span wider on large screens.
const spans = ['lg:col-span-7', 'lg:col-span-5', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-12'];
---
<section id="services" aria-labelledby="services-title" class="grain bg-sea py-24 text-sand md:py-36">
  <div class="container-x">
    <SectionHeading id="services-title" index="02" eyebrow={t('section.services')} title={services.title} accent={services.titleAccent} class="[&_.accent]:text-terra [&_p]:text-sand/70" />
    <ul class="mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-12">
      {services.items.map((item, i) => (
        <li
          class:list={[
            'group relative flex min-h-64 flex-col justify-between overflow-hidden rounded-(--radius-card) bg-sea-2 p-8 ring-1 ring-sand/10 transition-colors duration-500 hover:bg-terra hover:text-ink',
            spans[i % spans.length],
            i === services.items.length - 1 && 'lg:bg-terra lg:text-ink [&_.eyebrow]:lg:text-ink/70 [&_p]:lg:text-ink/80',
          ]}
          data-reveal
          style={`--i:${i % 3}`}
        >
          <span aria-hidden="true" class="accent pointer-events-none absolute -bottom-10 right-4 text-[12rem] leading-none text-sand/[0.07] transition-[transform,color] duration-700 ease-(--ease-out-expo) group-hover:-translate-x-3 group-hover:text-ink/15">{item.letter}</span>
          <span class="eyebrow text-sand/60 group-hover:text-ink/70">{item.letter} — {String(i + 1).padStart(2, '0')}</span>
          <div class="relative mt-16">
            <h3 class="text-2xl font-semibold tracking-[-0.03em] md:text-3xl">{item.title}</h3>
            <p class="mt-3 max-w-md leading-relaxed text-sand/75 group-hover:text-ink/80">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
