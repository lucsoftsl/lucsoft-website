---
import { withBase } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  url: string;
  class?: string;
  eager?: boolean;
  width?: number;
  height?: number;
}

const { src, alt, url, class: className, eager = false, width = 1600, height = 1000 } = Astro.props;
const host = new URL(url).hostname.replace(/^www\./, '');
---
<figure class:list={['overflow-hidden rounded-2xl bg-paper shadow-[0_40px_80px_-30px_rgb(19_19_19/0.45),0_0_0_1px_rgb(19_19_19/0.08)]', className]}>
  <div class="flex items-center gap-3 border-b border-line bg-paper px-4 py-2.5" aria-hidden="true">
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    <span class="mx-auto truncate rounded-full bg-sand-2 px-4 py-1 text-[0.7rem] text-ink-2">{host}</span>
    <span class="w-10"></span>
  </div>
  <img
    src={withBase(src)}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="block aspect-[16/10] w-full object-cover object-top"
  />
</figure>
