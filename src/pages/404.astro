---
// The host serves this one page for every missing URL, so it speaks both languages.
// noindex keeps it out of search results; it has no canonical or hreflang.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { alternatesFor, routes } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const en = useTranslations('en');
const es = useTranslations('es');
---
<BaseLayout locale="en" alternates={alternatesFor(routes.home)} title={en('notFound.title')} noindex>
  <section class="container-x flex min-h-[80dvh] flex-col justify-center pt-32 pb-20">
    <p class="eyebrow text-ink-2">Error 404</p>
    <h1 class="display mt-4 text-hero">{en('notFound.heading')} <span class="accent text-terra-deep">{en('notFound.headingAccent')}</span></h1>
    <p class="mt-6 max-w-md text-lg text-ink-2">{en('notFound.text')}</p>
    <p class="mt-2 max-w-md text-lg text-ink-2" lang="es">{es('notFound.text')}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={withBase(routes.home('en'))} class="btn btn-ink">{en('notFound.back')}</a>
      <a href={withBase(routes.home('es'))} class="btn btn-ghost" lang="es">{es('notFound.back')}</a>
    </div>
  </section>
</BaseLayout>
